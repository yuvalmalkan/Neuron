/* ═══════════════════════════════════════════════════════════
   rooms.qss  —  Neuron Rooms panel
   Tokens substituted by load_stylesheet() in uiConstants.py
   ═══════════════════════════════════════════════════════════ */

/* ── PANEL ROOT ─────────────────────────────────────────── */
#RoomsPanel {
    background: @WINDOW_BG@;
}

/* ── TOP ROOM BAR ───────────────────────────────────────── */
#RoomsTopBar {
    background: @SIDEBAR_BG@;
    border-bottom: 1px solid @SIDEBAR_BORDER@;
}

#TopBarScroll,
#TopBarScroll > QWidget,
#TabContainer {
    background: transparent;
    border: none;
}

#TopBarScroll QScrollBar:horizontal { height: 0; }

#RoomTabButton {
    background: transparent;
    color: @NAV_TEXT_IDLE@;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 0 10px;
    letter-spacing: 2px;
}

#RoomTabButton:hover {
    color: @NAV_TEXT_HOVER@;
    background: @NAV_BG_HOVER@;
}

#RoomTabButton:checked {
    color: @NAV_TEXT_ACTIVE@;
    border-color: @NAV_BORDER_ACTIVE@;
    background: @NAV_BG_ACTIVE@;
}

#NewRoomBtn {
    background: transparent;
    color: @NAV_TEXT_IDLE@;
    border: 1px solid @SIDEBAR_BORDER@;
    border-radius: 8px;
    padding: 0 12px;
    letter-spacing: 2px;
}

#NewRoomBtn:hover {
    color: @NAV_TEXT_HOVER@;
    border-color: @NAV_TEXT_HOVER@;
}

/* ── CHAT HEADER ────────────────────────────────────────── */
#ChatHeader {
    background: @SIDEBAR_BG@;
    border-bottom: 1px solid @SIDEBAR_BORDER@;
}

#ChatRoomLabel {
    color: @TEXT_TERMINAL@;
    letter-spacing: 3px;
}

#MembersLabel {
    color: @NAV_TEXT_IDLE@;
    letter-spacing: 1px;
}

#SecureTag {
    color: #2a6e2a;
    border: 1px solid #1a4e1a;
    border-radius: 5px;
    padding: 2px 8px;
    letter-spacing: 2px;
}

/* ── MESSAGE SCROLL ─────────────────────────────────────── */
#MsgScroll,
#MsgScroll > QWidget,
#MsgContainer {
    background: @WINDOW_BG@;
    border: none;
}

#MsgScroll QScrollBar:vertical {
    background: @SCROLLBAR_BG@;
    width: 4px;
    border-radius: 2px;
}

#MsgScroll QScrollBar::handle:vertical {
    background: @SCROLLBAR_HANDLE@;
    border-radius: 2px;
    min-height: 20px;
}

#MsgScroll QScrollBar::add-line:vertical,
#MsgScroll QScrollBar::sub-line:vertical {
    height: 0;
}

/* ── MESSAGE BUBBLES ────────────────────────────────────── */
#MsgSender {
    color: @TEXT_TERMINAL@;
    letter-spacing: 2px;
}

#MsgSender[mine="true"] {
    color: #3a7a5a;
}

#MsgTime {
    color: @SIDEBAR_BORDER@;
}

#BubbleText {
    background: @CARD_BG@;
    color: @TEXT_BODY@;
    border: 1px solid @CARD_BORDER@;
    border-radius: 4px 14px 14px 14px;
    padding: 12px 16px;
}

#BubbleText[mine="true"] {
    background: #060f0a;
    border-color: #1a3e1a;
    border-radius: 14px 4px 14px 14px;
    color: #4a8a6a;
}

#MsgStatus {
    color: @SIDEBAR_BORDER@;
    letter-spacing: 1px;
}

/* ── INPUT BAR ──────────────────────────────────────────── */
#InputBar {
    background: @SIDEBAR_BG@;
    border-top: 1px solid @SIDEBAR_BORDER@;
}

#ChatInput {
    background: @INPUT_BG@;
    color: @TEXT_BODY@;
    border: 1px solid @INPUT_BORDER@;
    border-radius: 12px;
    padding: 0 14px;
    selection-background-color: @INPUT_SELECTION@;
}

#ChatInput:focus {
    border-color: @INPUT_FOCUS@;
}

#ChatInput::placeholder {
    color: @NAV_TEXT_IDLE@;
}

#SendButton {
    background: transparent;
    color: @BTN_PRIMARY_TEXT@;
    border: 1px solid @BTN_PRIMARY_BORDER@;
    border-radius: 12px;
    letter-spacing: 2px;
}

#SendButton:hover {
    background: @BTN_PRIMARY_HOVER@;
}

#SendButton:pressed {
    background: @BTN_PRIMARY_PRESS@;
}

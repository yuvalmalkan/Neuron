/* ── GLOBAL ── */
QMainWindow { background: @WINDOW_BG@; }
QScrollArea { background: transparent; border: none; }
QWidget { font-family: '@FONT_TITLE@'; }

/* ── LAYOUT ELEMENTS ── */
#sidebar {
    background: @SIDEBAR_BG@;
    border-right: 1px solid @SIDEBAR_BORDER@;
}
#logoArea {
    background: @SIDEBAR_BG@;
    border-bottom: 1px solid @SIDEBAR_BORDER@;
}
#osintDashboard {
    background: @WINDOW_BG@;
}
#placeholderPage {
    background: @WINDOW_BG@;
}

/* ── REUSABLE CARD ── */
Card {
    background: @CARD_BG@;
    border: 1px solid @CARD_BORDER@;
    border-radius: 12px;
}

/* ── GLOWING INPUT FIELD ── */
GlowInput {
    background: @INPUT_BG@;
    border: 1px solid @INPUT_BORDER@;
    border-radius: 8px;
    color: @TEXT_BODY@;
    padding: 0 14px;
    selection-background-color: @INPUT_SELECTION@;
}
GlowInput:focus {
    border: 1px solid @INPUT_FOCUS@;
}
GlowInput::placeholder {
    color: @TEXT_PLACEHOLDER@;
}

/* ── CYBER BUTTON ── */
CyberButton {
    border-radius: 8px;
    padding: 0 20px;
    letter-spacing: 1px;
}

/* Primary Variant */
CyberButton[variant="primary"] {
    background: @BTN_PRIMARY_BG@;
    border: 1px solid @BTN_PRIMARY_BORDER@;
    color: @BTN_PRIMARY_TEXT@;
}
CyberButton[variant="primary"]:hover { background: @BTN_PRIMARY_HOVER@; }
CyberButton[variant="primary"]:pressed { background: @BTN_PRIMARY_PRESS@; }

/* Danger Variant */
CyberButton[variant="danger"] {
    background: @BTN_DANGER_BG@;
    border: 1px solid @BTN_DANGER_BORDER@;
    color: @BTN_DANGER_TEXT@;
}
CyberButton[variant="danger"]:hover { background: @BTN_DANGER_HOVER@; }
CyberButton[variant="danger"]:pressed { background: @BTN_DANGER_PRESS@; }

/* ── SIDEBAR NAV BUTTON ── */
NavButton {
    background: transparent;
    border: none;
    border-left: 3px solid transparent;
    border-radius: 0px;
    color: @NAV_TEXT_IDLE@;
    text-align: left;
    padding-left: 16px;
}
NavButton:hover {
    background: @NAV_BG_HOVER@;
    color: @NAV_TEXT_HOVER@;
}
NavButton:checked {
    background: @NAV_BG_ACTIVE@;
    border-left: 3px solid @NAV_BORDER_ACTIVE@;
    color: @NAV_TEXT_ACTIVE@;
    font-weight: bold;
}

/* ── RESULT DISPLAY ── */
ResultDisplay {
    background: @CARD_BG@;
    border: 1px solid @CARD_BORDER@;
    border-radius: 10px;
    color: @TEXT_TERMINAL@;
    padding: 14px;
    selection-background-color: @INPUT_SELECTION@;
}
ResultDisplay QScrollBar:vertical {
    background: @SCROLLBAR_BG@;
    width: 6px;
    border-radius: 3px;
}
ResultDisplay QScrollBar::handle:vertical {
    background: @SCROLLBAR_HANDLE@;
    border-radius: 3px;
}
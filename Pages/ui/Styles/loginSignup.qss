/* ── loginSignup.qss ── */

QMainWindow {
    border-image: url(@BwBgNeurons@) 0 0 0 0 stretch stretch;
}

AuthInput {
    background: @INPUT_BG@;
    border: 1px solid @INPUT_BORDER@;
    border-radius: 4px;
    color: @TEXT_BODY@;
    selection-background-color: @INPUT_SELECTION@;
}

AuthInput:focus {
    border: 1px solid @INPUT_FOCUS@;
    background: @WINDOW_BG@;
}

AuthInput::placeholder {
    color: @TEXT_PLACEHOLDER@;
}

StandardAuthButton {
    background: @BTN_PRIMARY_BG@;
    border: 1px solid @BTN_PRIMARY_BORDER@;
    color: @BTN_PRIMARY_TEXT@;
    border-radius: 4px;
}

StandardAuthButton:hover {
    background: @BTN_PRIMARY_HOVER@;
}

StandardAuthButton:pressed {
    background: @BTN_PRIMARY_PRESS@;
}

LinkButton {
    background: transparent;
    color: @NAV_TEXT_IDLE@;
    border: none;
    text-align: center;
}

LinkButton:hover {
    color: @NAV_TEXT_HOVER@;
    text-decoration: underline;
}

/* ── LOGIN TITLE / ERROR LABELS ── */
QLabel[role="title"] {
    color: @TEXT_TITLE@;
}

QLabel[role="error"] {
    color: @TEXT_ALERT@;
    font-family: '@FONT_MONO@';
}

QLabel[role="muted"] {
    color: @TEXT_MUTED@;
    font-family: '@FONT_MONO@';
}
